{
  "name": "advanced-movie-posters",
  "version": "1.2.0",
  "description": "Turn plain movie lists like \"Title (2024)\" into a gallery of movie posters.",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild main.ts --bundle --external:obsidian --external:electron --external:@codemirror/* --external:@lezer/* --format=cjs --target=es2020 --sourcemap=inline --outfile=main.js --watch",
    "build": "tsc --noEmit --skipLibCheck && esbuild main.ts --bundle --external:obsidian --external:electron --external:@codemirror/* --external:@lezer/* --format=cjs --target=es2020 --minify --outfile=main.js"
  },
  "keywords": ["obsidian", "obsidian-plugin", "movies", "posters", "gallery"],
  "license": "PolyForm-Strict-1.0.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
